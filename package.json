{
  "name": "donna-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"npm:dev:web\" \"npm:dev:api\"",
    "dev:v2": "concurrently -k -n web,api,algo \"npm:dev:web\" \"npm:dev:api\" \"npm:dev:algo\"",
    "dev:web": "vite",
    "dev:api": "node server/connectivity-server.mjs",
    "dev:algo": "cd algo-service && uvicorn app.main:app --reload --port 8090",
    "dev:stack": "docker compose up --build",
    "worker:retrain": "node server/workers/retrain-worker.mjs",
    "worker:telegram": "node server/telegram/bot.mjs",
    "migrate:legacy": "node scripts/import-legacy-to-postgres.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepare:design": "node scripts/prepare-design-assets.mjs",
    "visual:diff": "node scripts/visual-diff.mjs",
    "qa:screens": "node scripts/run-visual-qa.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "connect-redis": "^8.1.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "framer-motion": "^12.38.0",
    "helmet": "^8.1.0",
    "lucide-react": "^1.7.0",
    "pg": "^8.15.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^6.30.3",
    "recharts": "^3.8.1",
    "redis": "^5.8.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.59.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.13",
    "tailwindcss": "^3.4.13",
    "vite": "^6.4.2"
  }
}
